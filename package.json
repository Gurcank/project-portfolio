{
  "name": "project-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "velite build --strict && next dev",
    "build": "velite build --strict && next build",
    "start": "next start",
    "content": "velite build --strict",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "velite build --strict && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:tokens": "tsx scripts/check-tokens.ts",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "motion": "14.14.0",
    "next": "16.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "velite": "0.4.0",
    "vitest": "5.1.1"
  }
}
